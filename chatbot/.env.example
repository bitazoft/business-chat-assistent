# ============================================================
#  Business Chat Assistant - configuration
#  Copy to .env and fill in. Every value here has a working
#  default except API_KEY, DATABASE_URL and the WhatsApp block.
# ============================================================

# ---- LLM provider (OpenRouter, OpenAI-compatible) ----
AI_PROVIDER=GPT
API_KEY=your_openrouter_api_key
API_BASE=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- Cost control ----
# fixed    = always CHAT_MODEL (default; same behaviour as before)
# tiered   = cheap model for simple turns, strong model for orders, payments,
#            images, refunds, complaints and long conversations
# rotation = round-robin over MODEL_ROTATION, to spread spend and rate limits
COST_STRATEGY=fixed
MODEL_CHEAP=openai/gpt-4o-mini
MODEL_STANDARD=openai/gpt-4o-mini
MODEL_STRONG=openai/gpt-4o
MODEL_ROTATION=

# Per seller, per day, in USD. Past this the bot drops to the cheapest
# configured model instead of billing without limit. 0 = no cap.
DAILY_BUDGET_USD=0

# Answer bare greetings / "thanks" from a template with no LLM call at all.
SHORTCUT_REPLIES_ENABLED=true
# Reuse the answer to an identical *opening* question. Never applied to a turn
# that used a tool, so one customer's order data can't be served to another.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=900
TRACK_TOKEN_USAGE=true
# Optional JSON file overriding the built-in per-model prices (see /usage/models)
# MODEL_PRICING_FILE=config/model_pricing.json

# ---- Vision (reading customer images: receipts, product photos) ----
# Must be a vision-capable model. Defaults to CHAT_MODEL if unset.
VISION_MODEL=openai/gpt-4o-mini
VISION_TIMEOUT=60
# How far a receipt amount may differ from the order total before it's flagged
PAYMENT_AMOUNT_TOLERANCE=1.0

# ---- Agent ----
AGENT_MAX_ITERATIONS=8
MAX_CHAT_HISTORY=20
LANGUAGE_DETECTION_ENABLED=false
RAG_ENABLED=false
PRELOAD_MODELS=true

# ---- Database (matches database/docker-compose.yml) ----
# Port 6432: a native PostgreSQL install commonly holds 5432 and wins the
# bind, so the container's mapping looks fine while clients reach the wrong
# server. The container still listens on 5432 internally.
DATABASE_URL=postgresql://postgres:12345678@localhost:6432/assistant
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Fail fast instead of pinning a worker thread on the OS TCP timeout
DB_CONNECT_TIMEOUT=10
DB_ECHO=false
# Persist chat history so context survives a restart (needs migration 003)
PERSIST_CONVERSATIONS=true

# ---- File storage (payment proofs etc.): "s3" or "local" ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_BASE_URL=http://localhost:8001/uploads

# ---- AWS S3 (only used when STORAGE_BACKEND=s3) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ---- WhatsApp Cloud API (one block per business number, index from 0) ----
WHATSAPP_CONFIG_0_PHONE_NUMBER_ID=
WHATSAPP_CONFIG_0_ACCESS_TOKEN=
WHATSAPP_CONFIG_0_VERIFY_TOKEN=
WHATSAPP_CONFIG_0_BUSINESS_ACCOUNT_ID=

# Verify that webhook calls really came from Meta. The webhook is a public URL
# that can create orders, so turn this on in production. Get the app secret
# from your Meta app dashboard (App Settings -> Basic -> App Secret).
VERIFY_WEBHOOK_SIGNATURE=false
WHATSAPP_APP_SECRET=

# Replies longer than this are split into several messages (WhatsApp hard limit
# is 4096 characters and it rejects anything longer outright).
WHATSAPP_MAX_MESSAGE_CHARS=4000
WHATSAPP_SEND_RETRIES=3
# How long a message id is remembered, so a WhatsApp redelivery can't place a
# second order.
DEDUPE_TTL_SECONDS=900
# Show read receipts and a typing indicator while the bot is thinking
TYPING_INDICATOR=true

# ---- Sessions ----
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=5000
SESSION_SWEEP_INTERVAL=300

# ---- Rate limiting (per customer) ----
# Every message costs an LLM call, so this is a spend control as well as a
# load control.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Server / logging ----
LOG_LEVEL=INFO
DEBUG_MODE=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
# Comma-separated. "*" is fine for development; set real origins in production
# (with "*", credentialed requests are refused by browsers anyway).
CORS_ORIGINS=*
# Threads for the blocking work (LLM calls, database, storage)
WORKER_THREADS=16
# Uvicorn processes. Note: sessions, caches, rate limits and webhook dedupe are
# per-process, so leave this at 1 unless you move that state to Redis.
WEB_CONCURRENCY=1
