generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  phone           String
  password        String
  role            UserRole         @default(customer)
  address         String?
  created_at      DateTime         @default(now())
  seller_profiles seller_profiles?
}

model chat_logs {
  id               Int      @id @default(autoincrement())
  user_query       String   @db.VarChar
  intent           String?  @db.VarChar
  entities         Json?
  response         String   @db.VarChar
  timestamp        DateTime @default(now()) @db.Timestamp(6)
  customer_id      String?  @db.VarChar
  seller_id        Int
  response_time_ms Int?
}

model orders {
  id             Int             @id @default(autoincrement())
  status         String          @db.VarChar
  total_amount   Float
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  customer_id    String?         @db.VarChar
  seller_id      Int
  payment_method String?         @db.VarChar
  payment_status String?         @db.VarChar
  payment_proof  String?         @db.VarChar
  shipping_cost  String?         @db.VarChar
  notes          String?         @db.VarChar
  order_items    order_items[]
  customers      customers?      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_customers_fk")
  seller_profile seller_profiles @relation(fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_seller_profile_fk")
}

model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  price      Float
  quantity   Int
  orders     orders   @relation(fields: [order_id], references: [id])
  products   products @relation(fields: [product_id], references: [id])
}

model products {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar
  description    String?         @db.VarChar
  price          Float
  stock          Int
  seller_id      Int
  item_img       item_img[]
  order_items    order_items[]
  seller_profile seller_profiles @relation(fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_seller_profile_fk")
}

model customers {
  id         String    @id @db.VarChar
  name       String    @db.VarChar
  address    String    @db.VarChar
  number1    String    @db.VarChar
  number2    String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamp(6)
  email      String?   @db.VarChar
  orders     orders[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model item_img {
  product_id Int      @default(autoincrement())
  image      String   @db.VarChar
  id         Int      @id(map: "item_img_pk") @default(autoincrement())
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_img_products_fk")

}

model seller_profiles {
  id                 Int        @id(map: "SellerProfile_pkey") @default(autoincrement())
  user_id            Int        @unique(map: "SellerProfile_userId_key")
  shop_name          String
  gst_number         String?
  whatsapp_number_id String?    @db.VarChar
  orders             orders[]
  products           products[]
  users              users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "seller_profile_users_fk")
}

enum UserRole {
  customer
  seller
  admin
}
